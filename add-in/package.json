{
  "name": "vena-lite-addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vena-lite Office.js add-in for Excel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "setup-certs": "office-addin-dev-certs install",
    "icons": "python scripts/generate_icons.py",
    "start": "office-addin-debugging start manifest.xml desktop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.73.0",
    "@fluentui/react-icons": "^2.0.325",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.580",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
